{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/task-system/task.schema.json",
  "title": "Cross-Project Task Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_system_version",
    "id",
    "slug",
    "title",
    "type",
    "status",
    "status_reason",
    "created_at",
    "updated_at",
    "repository",
    "source",
    "branch",
    "revisions",
    "approvals",
    "acceptance_criteria",
    "plan_steps",
    "state_history",
    "git",
    "pull_request",
    "merge",
    "archive",
    "blocker",
    "risks"
  ],
  "$defs": {
    "nullableDateTime": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "revision",
        "head_sha",
        "approved_by",
        "approved_at",
        "source",
        "evidence"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "approved",
            "rejected",
            "invalidated",
            "not_applicable"
          ]
        },
        "revision": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "head_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-fA-F]{7,64}$"
        },
        "approved_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_at": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "source": {
          "enum": [
            "chat",
            "not_applicable"
          ]
        },
        "evidence": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^AC-\\d{2,}$"
        },
        "status": {
          "enum": [
            "pending",
            "passed",
            "failed",
            "blocked",
            "not_applicable"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "planStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "status",
        "supports"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^PLAN-\\d{2,}$"
        },
        "status": {
          "enum": [
            "pending",
            "in_progress",
            "completed",
            "blocked",
            "not_applicable"
          ]
        },
        "supports": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^AC-\\d{2,}$"
          }
        }
      }
    },
    "commit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha",
        "subject",
        "created_at"
      ],
      "properties": {
        "sha": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{7,64}$"
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "$ref": "#/$defs/nullableDateTime"
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "task_system_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "id": {
      "type": "string",
      "pattern": "^TASK-\\d{4}-\\d{3,}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "enum": [
        "feature",
        "bugfix",
        "refactor",
        "performance",
        "security",
        "audit",
        "research",
        "documentation",
        "dependency",
        "data",
        "ui_ux",
        "scaffolding",
        "other"
      ]
    },
    "status": {
      "enum": [
        "draft",
        "assessing",
        "researching",
        "awaiting_findings_approval",
        "planning",
        "awaiting_plan_approval",
        "approved",
        "creating_branch",
        "implementing",
        "testing",
        "reviewing",
        "committing",
        "pushing",
        "awaiting_pr_approval",
        "creating_pr",
        "waiting_for_ci",
        "awaiting_merge_approval",
        "merging",
        "completing",
        "completed",
        "archived",
        "blocked",
        "failed",
        "cancelled",
        "superseded"
      ]
    },
    "status_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "$ref": "#/$defs/nullableDateTime"
    },
    "updated_at": {
      "$ref": "#/$defs/nullableDateTime"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "default_branch",
        "remote",
        "provider",
        "issue_url"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "default_branch": {
          "type": "string",
          "minLength": 1
        },
        "remote": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "enum": [
            "github",
            "other"
          ]
        },
        "issue_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reference"
      ],
      "properties": {
        "kind": {
          "enum": [
            "human",
            "agent",
            "github_issue",
            "audit",
            "other"
          ]
        },
        "reference": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "base_branch",
        "base_commit",
        "created_at",
        "worktree_path"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "base_branch": {
          "type": "string",
          "minLength": 1
        },
        "base_commit": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-fA-F]{7,64}$"
        },
        "created_at": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "worktree_path": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "revisions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task",
        "findings",
        "plan"
      ],
      "properties": {
        "task": {
          "type": "integer",
          "minimum": 1
        },
        "findings": {
          "type": "integer",
          "minimum": 0
        },
        "plan": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "findings",
        "plan",
        "pull_request",
        "merge"
      ],
      "properties": {
        "findings": {
          "$ref": "#/$defs/approval"
        },
        "plan": {
          "$ref": "#/$defs/approval"
        },
        "pull_request": {
          "$ref": "#/$defs/approval"
        },
        "merge": {
          "$ref": "#/$defs/approval"
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/criterion"
      }
    },
    "plan_steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/planStep"
      }
    },
    "state_history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "at",
          "from",
          "to",
          "actor",
          "reason"
        ],
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "from": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              null,
              "draft",
              "assessing",
              "researching",
              "awaiting_findings_approval",
              "planning",
              "awaiting_plan_approval",
              "approved",
              "creating_branch",
              "implementing",
              "testing",
              "reviewing",
              "committing",
              "pushing",
              "awaiting_pr_approval",
              "creating_pr",
              "waiting_for_ci",
              "awaiting_merge_approval",
              "merging",
              "completing",
              "completed",
              "archived",
              "blocked",
              "failed",
              "cancelled",
              "superseded"
            ]
          },
          "to": {
            "enum": [
              "draft",
              "assessing",
              "researching",
              "awaiting_findings_approval",
              "planning",
              "awaiting_plan_approval",
              "approved",
              "creating_branch",
              "implementing",
              "testing",
              "reviewing",
              "committing",
              "pushing",
              "awaiting_pr_approval",
              "creating_pr",
              "waiting_for_ci",
              "awaiting_merge_approval",
              "merging",
              "completing",
              "completed",
              "archived",
              "blocked",
              "failed",
              "cancelled",
              "superseded"
            ]
          },
          "actor": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commits",
        "pushed",
        "remote",
        "head_sha",
        "pushed_at"
      ],
      "properties": {
        "commits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/commit"
          }
        },
        "pushed": {
          "type": "boolean"
        },
        "remote": {
          "type": "string",
          "minLength": 1
        },
        "head_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-fA-F]{7,64}$"
        },
        "pushed_at": {
          "$ref": "#/$defs/nullableDateTime"
        }
      }
    },
    "pull_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "number",
        "url",
        "base_branch",
        "head_branch",
        "head_sha",
        "created_at",
        "checks"
      ],
      "properties": {
        "state": {
          "enum": [
            "not_created",
            "open",
            "merged",
            "closed"
          ]
        },
        "number": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "base_branch": {
          "type": "string",
          "minLength": 1
        },
        "head_branch": {
          "type": "string",
          "minLength": 1
        },
        "head_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-fA-F]{7,64}$"
        },
        "created_at": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "status",
            "last_polled_at",
            "required",
            "results"
          ],
          "properties": {
            "status": {
              "enum": [
                "not_started",
                "pending",
                "passed",
                "failed",
                "cancelled",
                "timed_out"
              ]
            },
            "last_polled_at": {
              "$ref": "#/$defs/nullableDateTime"
            },
            "required": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string"
              }
            },
            "results": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "name",
                  "status",
                  "url"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "status": {
                    "enum": [
                      "queued",
                      "in_progress",
                      "passed",
                      "failed",
                      "cancelled",
                      "skipped"
                    ]
                  },
                  "url": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "uri"
                  }
                }
              }
            }
          }
        }
      }
    },
    "merge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "commit_sha",
        "merged_at",
        "merged_by"
      ],
      "properties": {
        "strategy": {
          "enum": [
            "repository_default",
            "squash",
            "merge",
            "rebase"
          ]
        },
        "commit_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-fA-F]{7,64}$"
        },
        "merged_at": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "merged_by": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "archive": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "path",
        "archival_pr_url",
        "archival_merge_sha",
        "archived_at"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_started",
            "preparing",
            "pr_open",
            "merged"
          ]
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        },
        "archival_pr_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "archival_merge_sha": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-fA-F]{7,64}$"
        },
        "archived_at": {
          "$ref": "#/$defs/nullableDateTime"
        }
      }
    },
    "blocker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "is_blocked",
        "reason",
        "since",
        "required_user_decision"
      ],
      "properties": {
        "is_blocked": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "since": {
          "$ref": "#/$defs/nullableDateTime"
        },
        "required_user_decision": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "risks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "remaining",
        "known_failures",
        "skipped_checks"
      ],
      "properties": {
        "remaining": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "known_failures": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skipped_checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
