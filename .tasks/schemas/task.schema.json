{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/nickth3man/task-system/main/.tasks/schemas/task.schema.json",
  "title": "Task System Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_system_version",
    "id",
    "slug",
    "title",
    "type",
    "status",
    "status_reason",
    "created_at",
    "updated_at",
    "repository",
    "source",
    "assessment",
    "branch",
    "revisions",
    "approvals",
    "acceptance_criteria",
    "plan_steps",
    "state_history",
    "git",
    "pull_request",
    "merge",
    "archive",
    "blocker",
    "risks"
  ],
  "$defs": {
    "nullableDateTime": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "sha": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{7,64}$"
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "revision", "artifact_sha256", "task_revision", "findings_revision", "head_sha", "approved_by", "approved_at", "source", "evidence"],
      "properties": {
        "status": {"enum": ["pending", "approved", "rejected", "invalidated"]},
        "revision": {"type": ["integer", "null"], "minimum": 0},
        "artifact_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "task_revision": {"type": ["integer", "null"], "minimum": 1},
        "findings_revision": {"type": ["integer", "null"], "minimum": 0},
        "head_sha": {"$ref": "#/$defs/sha"},
        "approved_by": {"type": ["string", "null"]},
        "approved_at": {"$ref": "#/$defs/nullableDateTime"},
        "source": {"enum": ["chat", "not_applicable"]},
        "evidence": {"type": ["string", "null"]}
      }
    }
  },
  "properties": {
    "schema_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "task_system_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "id": {"type": "string", "pattern": "^TASK-\\d{4}-\\d{3,}$"},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 1},
    "type": {"enum": ["feature", "bugfix", "refactor", "performance", "security", "audit", "research", "documentation", "dependency", "data", "ui_ux", "scaffolding", "other"]},
    "status": {"enum": ["draft", "assessing", "researching", "awaiting_findings_approval", "planning", "awaiting_plan_approval", "approved", "creating_branch", "implementing", "testing", "committing", "reviewing", "pushing", "awaiting_pr_approval", "creating_pr", "waiting_for_ci", "awaiting_merge_approval", "merging", "completing", "completed", "archived", "blocked", "failed", "cancelled", "superseded"]},
    "status_reason": {"type": ["string", "null"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "default_branch", "remote", "provider", "issue_url"],
      "properties": {
        "name": {"type": "string"},
        "default_branch": {"type": "string"},
        "remote": {"type": "string"},
        "provider": {"enum": ["github", "other"]},
        "issue_url": {"type": ["string", "null"], "format": "uri"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference"],
      "properties": {
        "kind": {"enum": ["human", "agent", "github_issue", "audit", "other"]},
        "reference": {"type": ["string", "null"]}
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_commit", "assessed_at", "base_drift_checked_at", "base_drift_result"],
      "properties": {
        "base_commit": {"$ref": "#/$defs/sha"},
        "assessed_at": {"$ref": "#/$defs/nullableDateTime"},
        "base_drift_checked_at": {"$ref": "#/$defs/nullableDateTime"},
        "base_drift_result": {"type": ["string", "null"]}
      }
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "base_branch", "base_commit", "created_at", "worktree_path"],
      "properties": {
        "name": {"type": "string"},
        "base_branch": {"type": "string"},
        "base_commit": {"$ref": "#/$defs/sha"},
        "created_at": {"$ref": "#/$defs/nullableDateTime"},
        "worktree_path": {"type": ["string", "null"]}
      }
    },
    "revisions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task", "findings", "plan"],
      "properties": {
        "task": {"type": "integer", "minimum": 1},
        "findings": {"type": "integer", "minimum": 0},
        "plan": {"type": "integer", "minimum": 0}
      }
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["findings", "plan", "pull_request", "merge"],
      "properties": {
        "findings": {"$ref": "#/$defs/approval"},
        "plan": {"$ref": "#/$defs/approval"},
        "pull_request": {"$ref": "#/$defs/approval"},
        "merge": {"$ref": "#/$defs/approval"}
      }
    },
    "acceptance_criteria": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "status", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^AC-\\d{2,}$"},
          "status": {"enum": ["pending", "passed", "failed", "blocked", "not_applicable"]},
          "evidence": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "plan_steps": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "status", "supports"],
        "properties": {
          "id": {"type": "string", "pattern": "^PLAN-\\d{2,}$"},
          "status": {"enum": ["pending", "in_progress", "completed", "blocked", "not_applicable"]},
          "supports": {"type": "array", "items": {"type": "string", "pattern": "^AC-\\d{2,}$"}}
        }
      }
    },
    "state_history": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["at", "from", "to", "actor", "reason"],
        "properties": {
          "at": {"type": "string", "format": "date-time"},
          "from": {"type": ["string", "null"]},
          "to": {"type": "string"},
          "actor": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    },
    "git": {
      "type": "object", "additionalProperties": false,
      "required": ["commits", "pushed", "remote", "candidate_head_sha", "head_sha", "pushed_at"],
      "properties": {
        "commits": {"type": "array", "items": {"type": "object", "additionalProperties": true, "required": ["sha", "subject"], "properties": {"sha": {"type": "string"}, "subject": {"type": "string"}}}},
        "pushed": {"type": "boolean"},
        "remote": {"type": "string"},
        "candidate_head_sha": {"$ref": "#/$defs/sha"},
        "head_sha": {"$ref": "#/$defs/sha"},
        "pushed_at": {"$ref": "#/$defs/nullableDateTime"}
      }
    },
    "pull_request": {
      "type": "object", "additionalProperties": false,
      "required": ["state", "number", "url", "base_branch", "head_branch", "head_sha", "created_at", "checks"],
      "properties": {
        "state": {"enum": ["not_created", "open", "merged", "closed"]},
        "number": {"type": ["integer", "null"], "minimum": 1},
        "url": {"type": ["string", "null"], "format": "uri"},
        "base_branch": {"type": "string"},
        "head_branch": {"type": "string"},
        "head_sha": {"$ref": "#/$defs/sha"},
        "created_at": {"$ref": "#/$defs/nullableDateTime"},
        "checks": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "last_polled_at", "required", "results"],
          "properties": {
            "status": {"enum": ["not_started", "pending", "passed", "failed", "cancelled", "timed_out"]},
            "last_polled_at": {"$ref": "#/$defs/nullableDateTime"},
            "required": {"type": "array", "items": {"type": "string"}},
            "results": {"type": "array", "items": {"type": "object"}}
          }
        }
      }
    },
    "merge": {
      "type": "object", "additionalProperties": false,
      "required": ["strategy", "commit_sha", "merged_at", "merged_by"],
      "properties": {
        "strategy": {"enum": ["repository_policy", "squash", "merge", "rebase"]},
        "commit_sha": {"$ref": "#/$defs/sha"},
        "merged_at": {"$ref": "#/$defs/nullableDateTime"},
        "merged_by": {"type": ["string", "null"]}
      }
    },
    "archive": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "path", "authorization", "pull_request"],
      "properties": {
        "status": {"enum": ["not_started", "preparing", "pr_open", "merged"]},
        "path": {"type": ["string", "null"]},
        "authorization": {"type": "object", "additionalProperties": true},
        "pull_request": {"type": "object", "additionalProperties": true}
      }
    },
    "blocker": {"type": "object", "additionalProperties": true},
    "risks": {
      "type": "object", "additionalProperties": false,
      "required": ["remaining", "known_failures", "skipped_checks"],
      "properties": {
        "remaining": {"type": "array", "items": {"type": "string"}},
        "known_failures": {"type": "array", "items": {"type": "string"}},
        "skipped_checks": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
