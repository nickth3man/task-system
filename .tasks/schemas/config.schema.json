{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/nickth3man/task-system/main/.tasks/schemas/config.schema.json",
  "title": "Task System Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "task_system_version", "mode", "timezone", "repository",
    "paths", "identifiers", "lifecycle", "research", "commands", "concurrency",
    "artifacts", "acceptance_criteria", "plan", "git", "github", "archive", "overrides"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "task_system_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "mode": {"enum": ["template", "live"]},
    "timezone": {"type": "string", "minLength": 1},
    "repository": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "default_branch", "remote", "provider"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "default_branch": {"type": "string", "minLength": 1},
        "remote": {"type": "string", "minLength": 1},
        "provider": {"enum": ["github", "other"]}
      }
    },
    "paths": {
      "type": "object", "additionalProperties": false,
      "required": ["active", "archive", "template", "index"],
      "properties": {
        "active": {"type": "string", "minLength": 1},
        "archive": {"type": "string", "minLength": 1},
        "template": {"type": "string", "minLength": 1},
        "index": {"type": "string", "minLength": 1}
      }
    },
    "identifiers": {"type": "object", "additionalProperties": true},
    "lifecycle": {"type": "object", "additionalProperties": true},
    "research": {"type": "object", "additionalProperties": true},
    "commands": {"type": "object", "additionalProperties": {"type": ["string", "null"]}},
    "concurrency": {"type": "object", "additionalProperties": true},
    "artifacts": {"type": "object", "additionalProperties": true},
    "acceptance_criteria": {"type": "object", "additionalProperties": true},
    "plan": {"type": "object", "additionalProperties": true},
    "git": {"type": "object", "additionalProperties": true},
    "github": {"type": "object", "additionalProperties": true},
    "archive": {"type": "object", "additionalProperties": true},
    "overrides": {"type": "object"}
  }
}
